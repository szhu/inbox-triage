{
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "tsc -p scripts && tsc -p src/server && tsc -p src/client && prettier --check .",
    "lint:fix": "tsc -p scripts && tsc -p src/server && tsc -p src/client && prettier --write .",
    "push": "bun run build && clasp push --force"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/google-apps-script": "^1.0.94",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.8.3",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
